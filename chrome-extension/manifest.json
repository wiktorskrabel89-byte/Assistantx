{
  "manifest_version": 3,
  "name": "AssistantX Clinical",
  "version": "1.0.0",
  "description": "Private clinical AI assistant for individual practitioners. Opens AssistantX in a side panel.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://*.assistantx.app/*",
    "http://localhost:3000/*"
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open AssistantX Clinical",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
