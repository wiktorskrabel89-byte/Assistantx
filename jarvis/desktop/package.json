{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "main": "main.js",
  "author": "AssistantX",
  "description": "Minimalny szkielet aplikacji Jarvis Desktop (Electron)",
  "repository": {
    "type": "git",
    "url": "https://github.com/wiktorskrabel89-byte/Assistantx.git"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "prepack": "node scripts/verify-python-runtime.js",
    "predist": "node scripts/verify-python-runtime.js",
    "predist:win": "node scripts/verify-python-runtime.js",
    "predist:win:arm64": "node scripts/verify-python-runtime.js",
    "_dev:native": "electron .",
    "dev": "node scripts/run-electron-dev.js",
    "start": "electron .",
    "pack": "electron-builder --dir --publish never",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --publish never --win nsis --x64",
    "dist:win:arm64": "electron-builder --publish never --win nsis --arm64",
    "dist:mac": "electron-builder --publish never --mac dmg --x64 --arm64",
    "dist:mac:arm64": "electron-builder --publish never --mac dmg --arm64",
    "dist:linux": "electron-builder --publish never --linux AppImage --x64",
    "dist:linux:arm64": "electron-builder --publish never --linux AppImage --arm64",
    "_dist:win:all:native": "electron-builder --publish never --win nsis --x64 --arm64",
    "dist:win:all": "node scripts/dist-win-all.js",
    "smoke:runtime": "node scripts/verify-python-runtime.js",
    "smoke:installer": "node scripts/verify-packaged-installer.js",
    "setup:local-ai": "powershell -ExecutionPolicy Bypass -File scripts/setup-env.ps1",
    "bootstrap:windows": "powershell -ExecutionPolicy Bypass -File scripts/JarvisSystemSetup.ps1",
    "publish:download": "node scripts/publish-installer.js",
    "dist:win:public": "npm run dist:win:all && npm run publish:download"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.assistantx.jarvis.desktop",
    "productName": "Jarvis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!scripts/**"
    ],
    "asarUnpack": [
      "**/node_modules/sql.js/dist/**"
    ],
    "extraResources": [
      {
        "from": "../../ai-agent",
        "to": "ai-agent",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/venv/**",
          "!**/.git/**"
        ]
      },
      {
        "from": "python",
        "to": "python"
      }
    ],
    "win": {
      "executableName": "Jarvis",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "JarvisSetup-${arch}.${ext}",
      "extraResources": [
        {
          "from": "scripts/post-install.ps1",
          "to": "post-install.ps1"
        },
        {
          "from": "scripts/uninstall.ps1",
          "to": "uninstall.ps1"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "JarvisSetup-${arch}.${ext}",
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "scripts/post-install.sh",
          "to": "post-install.sh"
        },
        {
          "from": "scripts/uninstall.sh",
          "to": "uninstall.sh"
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Jarvis-${arch}.${ext}",
      "category": "Utility"
    },
    "protocols": [
      {
        "name": "AssistantX",
        "schemes": [
          "assistantx"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Jarvis",
      "runAfterFinish": true,
      "include": "installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "wiktorskrabel89-byte",
        "repo": "Assistantx",
        "private": true
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "keytar": "^7.9.0",
    "sql.js": "^1.14.1",
    "ws": "^8.20.1"
  },
  "overrides": {
    "glob": "^10.4.5"
  }
}
