[Unit]
Description=JARVIS Linux Runtime (Docker Compose)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/jarvis/server
ExecStart=/usr/bin/docker compose --env-file /opt/jarvis/server/.env up -d --build
ExecStop=/usr/bin/docker compose --env-file /opt/jarvis/server/.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
