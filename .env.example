NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GROQ_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Your deployment's public URL (no trailing slash). Used for OAuth redirect URIs.
# Example: https://your-app.vercel.app or https://www.assistantx.pl
NEXT_PUBLIC_APP_URL=

# ── Supabase server-side (bypasses RLS – keep secret) ───────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ── Local queue worker (ai-agent/worker.py) ───────────────────────────────────
LOCAL_WORKER_ENABLED=true
LOCAL_WORKER_POLL_INTERVAL_SECONDS=1
LOCAL_WORKER_MAX_PROCESSING=2
LOCAL_WORKER_TASK_PICK_TIMEOUT_SECONDS=10
LOCAL_WORKER_DEFAULT_TEMPERATURE=0.0
LOCAL_WORKER_SOURCE_CODE_MAX_CHARS=16000
LOCAL_OLLAMA_BASE_URL=http://localhost:11434
LOCAL_OLLAMA_MODEL=qwen2.5:14b
LOCAL_OLLAMA_LIGHT_MODEL=qwen2.5:14b
LOCAL_OLLAMA_HEAVY_MODEL=qwen2.5-coder:32b
LOCAL_OLLAMA_LIGHT_KEEP_ALIVE=5m
LOCAL_OLLAMA_HEAVY_KEEP_ALIVE=0
LOCAL_OLLAMA_TIMEOUT_SECONDS=120
LOCAL_OLLAMA_RETRIES=2
LOCAL_WORKER_WEB_SEARCH_TIMEOUT_SECONDS=8
LOCAL_WORKER_WEB_SEARCH_MAX_RESULTS=3
CLOUD_FALLBACK_MODEL=qwen/qwen-2.5-14b-instruct
CLOUD_FALLBACK_TIMEOUT_SECONDS=90
CLOUD_FALLBACK_RETRIES=2
JARVIS_SEARXNG_URL=http://127.0.0.1:8080
JARVIS_WORKSPACE_ROOT=

# ── Web search (Tavily) ──────────────────────────────────────────────────────
TAVILY_API_KEY=

# ── Image generation ────────────────────────────────────────────────────────
IMAGE_GEN_API_URL=
IMAGE_GEN_PROVIDER_MODE=automatic1111
IMAGE_GEN_MODEL_LABEL=Local Forge/ComfyUI
IMAGE_GEN_TIMEOUT_MS=90000
# fal.ai key for image generation (alternative to OpenAI DALL-E)
FAL_KEY=
# OpenAI key – used for DALL-E image generation when FAL_KEY is not set
OPENAI_API_KEY=

# ── OpenRouter optional extras ───────────────────────────────────────────────
# HTTP Referer sent with OpenRouter requests (defaults to https://assistantx.pl)
OPENROUTER_HTTP_REFERER=
# Alternative Google AI Studio key name (alias for GOOGLE_AI_STUDIO_API_KEY)
GOOGLE_API_KEY=

# ── Stripe (payments) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── GitHub / Jarvis desktop integration ─────────────────────────────────────
# Any one of these three is sufficient; JARVIS_GITHUB_TOKEN is checked first.
# Used by /api/jarvis/version and /api/jarvis/download to authenticate GitHub
# API calls (avoids rate limiting on public repos).
JARVIS_GITHUB_TOKEN=
GITHUB_TOKEN=
GH_TOKEN=

# ── Jarvis linked accounts (OAuth for desktop / mobile) ─────────────────────
# Linked GitHub account — lets users connect their personal GitHub via Jarvis.
# Register an OAuth App at https://github.com/settings/developers and set:
#   Callback URL: ${NEXT_PUBLIC_APP_URL}/api/jarvis/linked-accounts/github?action=callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Linked Google account (Gmail + Drive) — lets users connect Google via Jarvis.
# Register an OAuth client at https://console.cloud.google.com/apis/credentials and set:
#   Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/jarvis/linked-accounts/google?action=callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Jarvis live desktop status ───────────────────────────────────────────────
# WebSocket URL of the realtime edge gateway. When set, the Jarvis tab shows
# live PC presence/status. Leave empty to disable (feature degrades gracefully).
# Example: wss://your-realtime-server.example.com/realtime
NEXT_PUBLIC_JARVIS_WS_URL=

# ── Jarvis Wake-on-LAN ───────────────────────────────────────────────────────
# Shared secret that Jarvis Desktop/Android can pass in the X-Jarvis-WoL-Secret
# header to call /api/jarvis/wol without a Supabase session token.
# Leave empty to require Supabase Bearer auth only.
JARVIS_WOL_SHARED_SECRET=

# Cloud Wake v1 feature flags
WAKE_V2_ENABLED=false
HIBERNATE_INTERCEPT_ENABLED=false
P2P_TUNNEL_ENABLED=false

# Dedicated EU wake microservice (IPv6/raw fallback + UDP impulse)
JARVIS_WAKE_VPS_BASE_URL=
JARVIS_WAKE_VPS_TOKEN=
JARVIS_HOME_TAILSCALE_URL=
JARVIS_INTERNAL_SECRET=

# ── Cloudflare (website-creator domain provisioning) ────────────────────────
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_BASE_DOMAIN=

# ── Northflank (website-creator deployment) ──────────────────────────────────
NORTHFLANK_API_KEY=
NORTHFLANK_PROJECT_ID=

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses
ADMIN_EMAILS=
